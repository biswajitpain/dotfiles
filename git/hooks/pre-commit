#!/usr/bin/env bash
# Pre-commit hook: block secrets from being committed.
# Installed globally via core.hooksPath by install.sh.

set -e

RED='\033[0;31m'
YELLOW='\033[1;33m'
NC='\033[0m'

FAILED=0

staged_files() {
    # Exclude the hooks directory itself — pattern strings inside hooks are not secrets
    git diff --cached --name-only --diff-filter=ACM | grep -v '^git/hooks/'
}

# ── 1. Block known secret file names ────────────────────────────────────────
SECRET_FILE_PATTERNS=(
    '\.env$'
    '\.env\.'
    'azure-subscriptions\.env$'
    'credentials\.json$'
    'secrets\.json$'
    'secret\.yaml$'
    'secret\.yml$'
    '\.pem$'
    '\.p12$'
    '\.pfx$'
    '\.keystore$'
)

for file in $(staged_files); do
    for pattern in "${SECRET_FILE_PATTERNS[@]}"; do
        if echo "$file" | grep -qE "$pattern"; then
            # Allow template files
            if echo "$file" | grep -qE '\.template$'; then
                continue
            fi
            echo -e "${RED}[SECRET BLOCK]${NC} Refusing to commit secret file: $file"
            FAILED=1
        fi
    done
done

# ── 2. Block private SSH / TLS key content ───────────────────────────────────
# Anchored to the start of the line. A real PEM block begins at column 0, which in
# a diff is "+-----BEGIN ...". Prose that merely mentions the marker is always
# prefixed (e.g. a markdown bullet "- `-----BEGIN ... `"), so anchoring keeps this
# rule active inside documentation instead of having to exempt docs wholesale.
PRIVATE_KEY_PATTERN='^\+?-----BEGIN [A-Z0-9 ]*PRIVATE KEY-----'

for file in $(staged_files); do
    if git diff --cached -- "$file" | grep -qE -- "$PRIVATE_KEY_PATTERN"; then
        echo -e "${RED}[SECRET BLOCK]${NC} Private key content detected in: $file"
        FAILED=1
    fi
done

# Files that legitimately contain the SHAPE of a secret: templates, the docs
# that explain the scheme, the audit scanner, and the test suite that proves the
# scanners work. Defined once so rules 3 and 4c cannot drift apart. This exempts
# CONTENT only — rules 1, 4 and 4b still apply to every path.
CONTENT_EXEMPT='\.template$|^DOCS\.md$|^CLAUDE\.md$|^README\.md$|^scripts/audit-repo\.sh$|^tests/'

# ── 3. Block high-entropy secret patterns ────────────────────────────────────
# Matches common token/key assignments, quoted or bare:
#   API_KEY="abc123..."   ACCESS_TOKEN=ghp_xxx   PASSWORD='hunter2'
#
# The alternation must be grouped SEPARATELY from the '=' or the '=' binds only
# to the last branch. An earlier version read (API_KEY|...|AZ_SUB_[A-Z_]+=")...
# which silently matched nothing but AZ_SUB_*: API_KEY=, PASSWORD= and a bare
# ACCESS_TOKEN=ghp_... all sailed through. Deliberately the same shape as
# "generic secret assignment" in scripts/audit-repo.sh — the two layers are
# meant to agree, and a hole in one is a hole in both.
SECRET_CONTENT_PATTERN='(SECRET|PASSWORD|PASSWD|API_KEY|API_SECRET|SECRET_KEY|ACCESS_TOKEN|AUTH_TOKEN|PRIVATE_KEY|AZ_SUB_[A-Z_]+)[A-Z_]*[[:space:]]*=[[:space:]]*['\''"]?[^[:space:]'\''"]{8,}'

for file in $(staged_files); do
    # Templates show the SHAPE of a secret by construction, docs describe it, and
    # scripts/audit-repo.sh and tests/ are lists of these patterns. Same exemption
    # list as rule 4c and as is_exempt() in audit-repo.sh, so the layers cannot
    # disagree. A template holding a REAL value is still caught by rule 5 below.
    #
    # tests/ is exempt from CONTENT rules only, never from the forbidden-path and
    # secret-filename rules above: a test may describe a secret, but no real
    # aws/config or id_ed25519 may hide under tests/ either.
    if echo "$file" | grep -qE "$CONTENT_EXEMPT"; then
        continue
    fi
    if git diff --cached -- "$file" | grep -qE "$SECRET_CONTENT_PATTERN"; then
        echo -e "${RED}[SECRET BLOCK]${NC} Possible secret value detected in: $file"
        echo -e "${YELLOW}  If this is a false positive, use: git commit --no-verify${NC}"
        FAILED=1
    fi
done

# ── 4. Block SSH private key files (files without .pub extension) ─────────────
for file in $(staged_files); do
    # Anchored at any path component, not just the repo root: a key is no less a
    # key for sitting in tests/fixtures/ or vendor/.
    if echo "$file" | grep -qE '(^|/)(ssh|\.ssh)/|(^|/)id_(rsa|dsa|ecdsa|ed25519)' && \
       ! echo "$file" | grep -qE '\.pub$|(^|/)config$|known_hosts$|authorized_keys$'; then
        echo -e "${RED}[SECRET BLOCK]${NC} Possible SSH private key file: $file"
        FAILED=1
    fi
done

# ── 4b. Block credential-bearing config paths outright ───────────────────────
# These belong in $DOTFILES_LOCAL_DIR (outside the repo), never here. The
# absence of this rule is what let aws/config and kube/config get committed.
# Matched at any path component, not just the repo root. An anchored '^aws/config$'
# says nothing about tests/fixtures/aws/config or vendor/aws/config, and a real
# credential file is a real credential file wherever it is parked.
FORBIDDEN_PATHS=(
    '(^|/)aws/config$'
    '(^|/)aws/credentials$'
    '(^|/)kube/config$'
    '(^|/)azure-subscriptions\.env$'
    '(^|/)\.gitconfig\.[^./]*$'   # per-machine identities; *.template is fine
)

for file in $(staged_files); do
    for pattern in "${FORBIDDEN_PATHS[@]}"; do
        if echo "$file" | grep -qE "$pattern"; then
            echo -e "${RED}[SECRET BLOCK]${NC} $file must not be tracked — it belongs in \$DOTFILES_LOCAL_DIR"
            echo -e "${YELLOW}  Commit a templates/ version instead; bootstrap.sh renders the real file.${NC}"
            FAILED=1
        fi
    done
done

# ── 4c. Block cloud infrastructure identifiers ───────────────────────────────
# Account IDs, role ARNs, external IDs and cluster endpoints are environment
# traces even when they are not strictly credentials.
INFRA_PATTERNS=(
    'AKIA[0-9A-Z]{16}'
    'aws_secret_access_key[[:space:]]*='
    'arn:aws[a-z-]*:[a-z0-9-]*:[a-z0-9-]*:[0-9]{12}:'
    'external_id[[:space:]]*=[[:space:]]*[A-Za-z0-9._-]{8,}'
    'certificate-authority-data:[[:space:]]*[A-Za-z0-9+/=]{40,}'
    'client-(certificate|key)-data:[[:space:]]*[A-Za-z0-9+/=]{40,}'
    'server:[[:space:]]*https?://[A-Za-z0-9.-]+'
)

for file in $(staged_files); do
    # Templates, docs, the audit script and the test suite legitimately show
    # pattern shapes. See CONTENT_EXEMPT above.
    if echo "$file" | grep -qE "$CONTENT_EXEMPT"; then
        continue
    fi
    for pattern in "${INFRA_PATTERNS[@]}"; do
        if git diff --cached -- "$file" | grep -qE -- "$pattern"; then
            echo -e "${RED}[SECRET BLOCK]${NC} cloud infrastructure identifier in: $file"
            echo -e "${YELLOW}  Matched: $pattern${NC}"
            FAILED=1
        fi
    done
done

# ── 5. Warn on .env.template files that contain real-looking values ───────────
UUID_PATTERN='[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}'

# Obvious placeholders are the whole point of a template, so they are not a
# finding: the all-zero GUID, all-f, and xxxx forms.
UUID_PLACEHOLDER='00000000-0000|ffffffff-ffff|[xX]{8}-[xX]{4}'

for file in $(staged_files); do
    if echo "$file" | grep -qE '\.template$'; then
        if git diff --cached -- "$file" | grep -vE "$UUID_PLACEHOLDER" | grep -qE "$UUID_PATTERN"; then
            echo -e "${YELLOW}[SECRET WARN]${NC} Real-looking UUID found in template: $file"
            echo -e "${YELLOW}  Templates should use placeholder values, not real IDs.${NC}"
            FAILED=1
        fi
    fi
done

if [ "$FAILED" -ne 0 ]; then
    echo ""
    echo -e "${RED}Commit blocked.${NC} Remove secrets before committing."
    echo "To skip this check (only if you're sure): git commit --no-verify"
    exit 1
fi

exit 0
