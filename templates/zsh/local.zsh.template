# ~/.dotfiles-local/zsh/local.zsh — local shell overrides, NEVER committed.
#
# Sourced last by .zshrc, so anything here overrides the tracked config.
# This is where host-specific things belong: internal hostnames, jump hosts,
# work directory layouts, per-employer paths, one-off aliases.
#
# Install:  cp templates/zsh/local.zsh.template ~/.dotfiles-local/zsh/local.zsh
#
# Matching SSH host definitions go in ~/.ssh/config.local (also untracked).

# ── Example: internal dev hosts ──────────────────────────────────────────────
# alias devbox="ssh devbox"
# alias devsync="unison mysyncroot"
