#     if [ $# -lt 1 ]; then
#         echo "Usage: portfwd <port>" >&2
#         return 1
#     fi
#     ssh -N -L "$1:localhost:$1" devbox
# }

# ── Example: work-specific paths ─────────────────────────────────────────────
# export GOPATH="$HOME/work/go"
# export PATH="$PATH:$HOME/.toolbox/bin"

# ── Example: employer tooling ────────────────────────────────────────────────
# export SOME_INTERNAL_ENDPOINT="https://internal.example.invalid"
